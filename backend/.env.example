# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Providers ---
# routing:   mapbox | ors | mock
# geocoding: mapbox | ors | mock   (defaults to the routing provider)
# weather:   open_meteo | mock
ROUTING_PROVIDER=mapbox
GEOCODING_PROVIDER=mapbox
WEATHER_PROVIDER=open_meteo

# --- Keys ---
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

# Optional: restrict geocoding to one country (ISO 3166 alpha-2), e.g. US
GEOCODING_COUNTRY=

# Weather cache lifetime (seconds)
WEATHER_CACHE_TTL_SECONDS=1800
