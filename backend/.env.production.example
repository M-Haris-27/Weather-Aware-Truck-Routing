# Production Environment Variables for Render
# Copy these to Render's Environment Variables section

# Django Settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=your-super-secret-key-here-generate-a-random-one
DJANGO_ALLOWED_HOSTS=.onrender.com

# CORS - Add your Vercel domain after deployment
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# API Keys (REQUIRED)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Provider Configuration
ROUTING_PROVIDER=mapbox
GEOCODING_PROVIDER=mapbox
WEATHER_PROVIDER=open_meteo

# Rate Limiting
THROTTLE_ANALYZE=30/min
THROTTLE_GEOCODE=120/min

# Optional
GEOCODING_COUNTRY=
WEATHER_CACHE_TTL_SECONDS=1800
